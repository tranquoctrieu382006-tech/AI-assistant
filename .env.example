# === App Environment ===
APP_NAME="Mini AI Assistant"
APP_VERSION="2.0.0"
# Lưu ý: Swagger UI (/docs) và ReDoc (/redoc) chỉ kích hoạt khi DEBUG=true
ENVIRONMENT=development
DEBUG=false

# === LLM Configuration ===
# Mô hình mặc định (thay đổi để đổi mô hình, KHÔNG cần sửa code)
DEFAULT_MODEL=google_genai/gemini-3.5-flash-lite

# --- Mô hình mạnh (dùng cho sinh SQL phức tạp, tổng hợp, judge) ---
STRONG_MODEL=google_genai/gemini-3.6-flash

# --- Mô hình nhanh/rẻ (dùng cho RAG, NLQ và question rewriting theo cấu hình mẫu) ---
FAST_MODEL=google_genai/gemini-3.5-flash-lite

# --- Mô hình local (inference chạy qua Ollama trên máy) ---
LOCAL_MODEL=ollama/gemma3:12b
# RAG, NLQ and question rewriting use Gemini by default.
RAG_MODEL=fast
QUESTION_REWRITER_MODEL=fast
NLQ_MODEL=fast
NLQ_MODEL_TIMEOUT_SECONDS=60
NLQ_MODEL_MAX_RETRIES=1
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_DIMENSIONS=1024
RAG_NUM_CTX=8192
# === Database Configuration (PostgreSQL / pgvector) ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ai_assistant_demo
NLQ_READER_PASSWORD=your_secure_nlq_reader_password
# DATABASE_URL and NLQ_DATABASE_URL are derived from the settings above when
# left empty, so the password is defined only once. Set them explicitly only
# when connecting to a host that differs from POSTGRES_HOST.
# DATABASE_URL=postgresql://postgres:...@127.0.0.1:5432/ai_assistant_demo
# NLQ_DATABASE_URL=postgresql://ai_nlq_reader:...@127.0.0.1:5432/ai_assistant_demo
NLQ_MAX_ROWS=200
NLQ_STATEMENT_TIMEOUT_MS=5000
NLQ_MAX_REPAIRS=2
NLQ_SCHEMA_CACHE_TTL_SECONDS=600
NLQ_SCHEMA_DICTIONARY_PATH=data/demo_sales_warehouse/data_dictionary.md
RAG_DOCUMENT_DIR=data/demo_sales_warehouse
RAG_EXCLUDE_FILES=["README.md","data_dictionary.md","nguon_dataset.md"]
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MIN_RELEVANCE_SCORE=0.5
RAG_EMBEDDING_BATCH_SIZE=64
RAG_MODEL_TIMEOUT_SECONDS=30
RAG_LOCAL_MODEL_TIMEOUT_SECONDS=90
RAG_MODEL_MAX_RETRIES=1
QUESTION_REWRITER_TIMEOUT_SECONDS=10
RAG_STREAM_FIRST_TOKEN_TIMEOUT_SECONDS=35
RAG_STREAM_IDLE_TIMEOUT_SECONDS=15
RAG_RETRIEVAL_TIMEOUT_SECONDS=60
LLM_TIMEOUT_SECONDS=90
BM25_REVISION_TTL_SECONDS=5
APP_WORKERS=1
SEARCH_MODE=vector
USE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_POOL_SIZE=20
DATABASE_CONNECTION_TIMEOUT_SECONDS=3

# === API Keys (KHÔNG commit file .env!) ===
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AI...
GROQ_API_KEY=gsk_...

# === Langfuse ===
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# === App ===
APP_HOST=127.0.0.1
APP_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Generate a random key of at least 32 characters; the placeholder intentionally fails closed.
APP_API_KEY=CHANGE_ME
API_RATE_LIMIT_PER_MINUTE=60
# Only configure trusted proxy addresses when they overwrite X-Forwarded-For.
TRUSTED_PROXY_IPS=[]
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]
