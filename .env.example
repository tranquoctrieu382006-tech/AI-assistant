# === App Environment ===
ENVIRONMENT=development
DEBUG=true

# === LLM Configuration ===
# Mô hình mặc định (thay đổi để đổi mô hình, KHÔNG cần sửa code)
DEFAULT_MODEL=ollama/gemma3:12b

# --- Mô hình mạnh (dùng cho sinh SQL phức tạp, tổng hợp, judge) ---
STRONG_MODEL=openai/gpt-4o
# STRONG_MODEL=google_genai/gemini-2.0-pro
# STRONG_MODEL=groq/llama-3.3-70b-versatile

# --- Mô hình nhanh/rẻ (dùng cho router; chỉ dùng cho rewrite khi chọn rõ bên dưới) ---
FAST_MODEL=openai/gpt-4o-mini
# FAST_MODEL=google_genai/gemini-2.0-flash
# FAST_MODEL=groq/llama-3.1-8b-instant

# --- Mô hình local (inference chạy qua Ollama trên máy) ---
LOCAL_MODEL=ollama/gemma3:12b
# RAG uses the local role unless a cloud model is deliberately selected.
RAG_MODEL=local
# Rewriter receives conversation history. Keep local by default; set to `fast` only if cloud processing is acceptable.
QUESTION_REWRITER_MODEL=local
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
RAG_NUM_CTX=8192
# Set your actual local PostgreSQL credentials; do not commit the real value.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/ai_assistant_demo
RAG_DOCUMENT_DIR=data/demo_sales_warehouse
RAG_EXCLUDE_FILES=["README.md","data_dictionary.md","nguon_dataset.md"]
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MIN_RELEVANCE_SCORE=0.5
RAG_EMBEDDING_BATCH_SIZE=64
LLM_TIMEOUT_SECONDS=300
SEARCH_MODE=vector
USE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_POOL_SIZE=20
DATABASE_CONNECTION_TIMEOUT_SECONDS=3

# === API Keys (KHÔNG commit file .env!) ===
OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AI...
# GROQ_API_KEY=gsk_...

# === Langfuse ===
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# === App ===
APP_HOST=127.0.0.1
APP_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Generate a random key of at least 32 characters; the placeholder intentionally fails closed.
APP_API_KEY=CHANGE_ME
API_RATE_LIMIT_PER_MINUTE=60
# Only configure trusted proxy addresses when they overwrite X-Forwarded-For.
TRUSTED_PROXY_IPS=[]
